                <Field name="Test Status" size="1073741823" source="Formula: // the only not tested reasons here are missing prior candles with trades or relative range beyond threshold&#xA;&#xA;if IsNull([Test Status])&#xA;then &#xA;  if IsNull([Reference Price (Local Currency)])&#xA;  then &quot;No&quot;&#xA;  else &quot;Yes&quot;&#xA;  endif&#xA;else&#xA;[Test Status]&#xA;endif" type="V_WString" />
