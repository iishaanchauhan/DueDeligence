                <Field name="Reference Price High (Local Currency)" source="Formula: IF IsNull([Reference Price (Local Currency)]) &#xA; then Null()&#xA;elseif Uppercase([Price type]) = &quot;BID&quot; THEN &#xA; [Reference Price High (Quote Currency)]/[Reference price (mid)] &#xA;    * [Reference price (bid)] &#xA;    *[FX rate to audited entity's local currency]&#xA;ELSE &#xA; [Reference Price High (Quote Currency)] * [FX rate to audited entity's local currency] ENDIF " type="Double" />
                <Field name="Reference Price Low (Local Currency)" source="Formula: IF IsNull([Reference Price (Local Currency)]) &#xA; then Null()&#xA;elseif Uppercase([Price type]) = &quot;BID&quot; &#xA; THEN &#xA; [Reference Price Low (Quote Currency)]/[Reference price (mid)]&#xA; *[Reference price (bid)] * [FX rate to audited entity's local currency]&#xA;ELSE [Reference Price Low (Quote Currency)] * [FX rate to audited entity's local currency]&#xA;ENDIF" type="Double" />
                <Field name="Reference Market Value (Local Currency)" source="Formula: [Reference Price (Local Currency)] * [Asset Amount]" type="Double" />
                <Field name="Reference Market Value High (Local Currency)" source="Formula: [Reference Price High (Local Currency)] * [Asset Amount]" type="Double" />
                <Field name="Reference Market Value Low (Local Currency)" source="Formula: [Reference Price Low (Local Currency)] * [Asset Amount]" type="Double" />
                <Field name="Reference Market Value (Base Currency)" source="Formula: [Reference Price (Base Currency)] * [Asset Amount]" type="Double" />
                <Field name="Reference Market Value High (Base Currency)" source="Formula: [Reference Price High (Local Currency)] * [Asset Amount] * [FX rate local to base currency]" type="Double" />
                <Field name="Reference Market Value Low (Base Currency)" source="Formula: [Reference Price Low (Local Currency)] * [Asset Amount] *[FX rate local to base currency]" type="Double" />
                <Field name="Price Deviation (Local Currency)" source="Formula: if [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA;[Client Price (Local Currency)] - [Reference Price (Local Currency)]&#xA;endif" type="Double" />
                <Field name="Price Deviation Out of Range (Local Currency)" source="Formula: If [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA; IF [Client Price (Local Currency)] &gt;&#xA;  [Reference Price High (Local Currency)]&#xA;&#xA; THEN [Client Price (Local Currency)]-&#xA;  [Reference Price High (Local Currency)] &#xA;&#xA; elseif [Client Price (Local Currency)] &lt; &#xA;  [Reference Price Low (Local Currency)]&#xA;&#xA; then [Client Price (Local Currency)]-&#xA;  [Reference Price Low (Local Currency)]&#xA;    ELSE&#xA;    0&#xA;   ENDIF&#xA;endif" type="Double" />
                <Field name="Total Deviation (Netted, Local Currency)" source="Formula: [Client Market Value (Local Currency)] - [Reference Market Value (Local Currency)]" type="Double" />
                <Field name="Deviation Out of Range (Netted, Local Currency)" source="Formula: If [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA;[Price Deviation Out of Range (Local Currency)] * [Asset Amount]&#xA;endif&#xA;" type="Double" />
                <Field name="Deviation Out of Range (Netted, Base Currency)" source="Formula: If [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA; [Price Deviation Out of Range (Local Currency)] &#xA; * [FX rate local to base currency] * [Asset Amount]&#xA;ENDIF&#xA;" type="Double" />
                <Field name="Deviation Out of Range (Absolute, Base Currency)" source="Formula: ABS([Deviation Out of Range (Netted, Base Currency)])" type="Double" />
                <Field name="Total Deviation (Netted, Base Currency)" source="Formula: [Price Deviation (Local Currency)] * [FX rate local to base currency] * [Asset Amount]" type="Double" />
                <Field name="Total Deviation (Absolute, Base Currency)" source="Formula: ABS([Total Deviation (Netted, Base Currency)])" type="Double" />
                <Field name="Out of Range" size="1073741823" source="Formula: // Official name: Out of range&#xA;if [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;elseif [Deviation Out of Range (Netted, Base Currency)] = 0&#xA;then &quot;No&quot; &#xA;else &quot;Yes&quot;&#xA;endif" type="V_WString" />
