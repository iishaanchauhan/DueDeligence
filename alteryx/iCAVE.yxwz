        <Node ToolID="373">
          <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
            <Position x="4722" y="450" />
          </GuiSettings>
          <Properties>
            <Configuration>
              <FormulaFields>
                <FormulaField expression="[Client Market Value (Local Currency)] / [Asset Amount]&#xA;" field="Client Price (Local Currency)" size="8" type="Double" />
                <FormulaField expression="IF&#xA;Uppercase([Price type]) = &quot;MID&quot; &#xA;THEN&#xA;[Reference price (mid)] &#xA;else&#xA;[Reference price (bid)]&#xA;ENDIF" field="Reference Price (Quote Currency)" size="8" type="Double" />
                <FormulaField expression="if ([Reference Price High (Quote Currency)] - [Reference Price Low (Quote Currency)])/[Reference Price (Quote Currency)] &lt;= 0.05 &#xA;// cap the relative range at 5%&#xA;then&#xA;[Reference Price (Quote Currency)] * [FX rate to audited entity's local currency]&#xA;else Null()&#xA;endif	&#xA;" field="Reference Price (Local Currency)" size="8" type="Double" />
                <FormulaField expression="if ([Reference Price High (Quote Currency)] - [Reference Price Low (Quote Currency)])/[Reference Price (Quote Currency)] &lt;= 0.05 &#xA;// cap the relative range at 5%&#xA;then&#xA;[Reference Price (Quote Currency)] * [FX rate to audited entity's base currency]&#xA;else Null()&#xA;endif" field="Reference Price (Base Currency)" size="8" type="Double" />
                <FormulaField expression="[FX rate to audited entity's base currency]/[FX rate to audited entity's local currency]" field="FX rate local to base currency" size="8" type="Double" />
                <FormulaField expression="// the only not tested reasons here are missing prior candles with trades or relative range beyond threshold&#xA;&#xA;if IsNull([Test Status])&#xA;then &#xA;  if IsNull([Reference Price (Local Currency)])&#xA;  then &quot;No&quot;&#xA;  else &quot;Yes&quot;&#xA;  endif&#xA;else&#xA;[Test Status]&#xA;endif" field="Test Status" size="1073741823" type="V_WString" />
                <FormulaField expression="if IsNull([Reason not tested]) &#xA;then &#xA;  	if Uppercase([Price type]) = &quot;MID&quot; and IsNull([Reference price (mid)])&#xA;	then &quot;Median price not available due to insufficient trading activity at or prior to the snap-time&quot;&#xA;  	elseif Uppercase([Price type]) = &quot;BID&quot; and IsNull([Reference price (bid)]) &#xA;	then&quot;Bid prices not available for this asset at this snaptime&quot;&#xA;	elseif ([Reference Price High (Quote Currency)] - [Reference Price Low (Quote Currency)])/[Reference Price (Quote Currency)] &gt; 0.05 &#xA;	then &quot;Relative price high-low range exceeded test threshold&quot;&#xA;	else [Reason not tested]	&#xA;	endif&#xA;else&#xA;[Reason not tested]&#xA;endif" field="Reason not tested" size="1073741823" type="V_WString" />
                <FormulaField expression="if [Test Status]=&quot;No&quot;&#xA;then Null()&#xA;else [Client Market Value (Local Currency)] * [FX rate local to base currency]&#xA;endif" field="Client Market Value Tested Calculated (Base Currency)" size="8" type="Double" />
                <FormulaField expression="if [Test Status] = &quot;Yes&quot;&#xA;then&#xA;[Client Market Value (Base Currency)]&#xA;else&#xA;Null()&#xA;endif" field="Client Market Value Tested (Base Currency)" size="8" type="Double" />
                <FormulaField expression="IF IsNull([Reference Price (Local Currency)]) &#xA;	then Null()&#xA;elseif Uppercase([Price type]) = &quot;BID&quot; THEN &#xA;	[Reference Price High (Quote Currency)]/[Reference price (mid)] &#xA;    * [Reference price (bid)] &#xA;    *[FX rate to audited entity's local currency]&#xA;ELSE &#xA;	[Reference Price High (Quote Currency)] * [FX rate to audited entity's local currency] ENDIF " field="Reference Price High (Local Currency)" size="8" type="Double" />
                <FormulaField expression="IF IsNull([Reference Price (Local Currency)]) &#xA;	then Null()&#xA;elseif Uppercase([Price type]) = &quot;BID&quot; &#xA;	THEN &#xA;	[Reference Price Low (Quote Currency)]/[Reference price (mid)]&#xA;	*[Reference price (bid)] * [FX rate to audited entity's local currency]&#xA;ELSE [Reference Price Low (Quote Currency)] * [FX rate to audited entity's local currency]&#xA;ENDIF" field="Reference Price Low (Local Currency)" size="8" type="Double" />
                <FormulaField expression="[Reference Price (Local Currency)] * [Asset Amount]" field="Reference Market Value (Local Currency)" size="8" type="Double" />
                <FormulaField expression="[Reference Price High (Local Currency)] * [Asset Amount]" field="Reference Market Value High (Local Currency)" size="8" type="Double" />
                <FormulaField expression="[Reference Price Low (Local Currency)] * [Asset Amount]" field="Reference Market Value Low (Local Currency)" size="8" type="Double" />
                <FormulaField expression="[Reference Price (Base Currency)] * [Asset Amount]" field="Reference Market Value (Base Currency)" size="8" type="Double" />
                <FormulaField expression="[Reference Price High (Local Currency)] * [Asset Amount] * [FX rate local to base currency]" field="Reference Market Value High (Base Currency)" size="8" type="Double" />
                <FormulaField expression="[Reference Price Low (Local Currency)] * [Asset Amount] *[FX rate local to base currency]" field="Reference Market Value Low (Base Currency)" size="8" type="Double" />
                <FormulaField expression="if [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA;[Client Price (Local Currency)] - [Reference Price (Local Currency)]&#xA;endif" field="Price Deviation (Local Currency)" size="8" type="Double" />
                <FormulaField expression="If [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA;	IF [Client Price (Local Currency)] &gt;&#xA;		[Reference Price High (Local Currency)]&#xA;&#xA;	THEN [Client Price (Local Currency)]-&#xA;		[Reference Price High (Local Currency)] &#xA;&#xA;	elseif [Client Price (Local Currency)] &lt; &#xA;		[Reference Price Low (Local Currency)]&#xA;&#xA;	then [Client Price (Local Currency)]-&#xA;		[Reference Price Low (Local Currency)]&#xA;    ELSE&#xA;    0&#xA;  	ENDIF&#xA;endif" field="Price Deviation Out of Range (Local Currency)" size="8" type="Double" />
                <FormulaField expression="[Client Market Value (Local Currency)] - [Reference Market Value (Local Currency)]" field="Total Deviation (Netted, Local Currency)" size="8" type="Double" />
                <FormulaField expression="If [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA;[Price Deviation Out of Range (Local Currency)] * [Asset Amount]&#xA;endif&#xA;" field="Deviation Out of Range (Netted, Local Currency)" size="8" type="Double" />
                <FormulaField expression="If [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA;	[Price Deviation Out of Range (Local Currency)] &#xA;	* [FX rate local to base currency] * [Asset Amount]&#xA;ENDIF&#xA;" field="Deviation Out of Range (Netted, Base Currency)" size="8" type="Double" />
                <FormulaField expression="ABS([Deviation Out of Range (Netted, Base Currency)])" field="Deviation Out of Range (Absolute, Base Currency)" size="8" type="Double" />
                <FormulaField expression="[Price Deviation (Local Currency)] * [FX rate local to base currency] * [Asset Amount]" field="Total Deviation (Netted, Base Currency)" size="8" type="Double" />
                <FormulaField expression="ABS([Total Deviation (Netted, Base Currency)])" field="Total Deviation (Absolute, Base Currency)" size="8" type="Double" />
                <FormulaField expression="// Official name: Out of range&#xA;if [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;elseif [Deviation Out of Range (Netted, Base Currency)] = 0&#xA;then &quot;No&quot; &#xA;else &quot;Yes&quot;&#xA;endif" field="Out of Range" size="1073741823" type="V_WString" />
                <FormulaField expression="if [Snap-time Reference Price High (UTC)] = &quot;00:00:00&quot; then &quot;24:00:00&quot; else [Snap-time Reference Price High (UTC)]&#xA;endif" field="Snap-time Reference Price High (UTC)" size="8" type="String" />
                <FormulaField expression="if [Snap-time Reference Price Low (UTC)] = &quot;00:00:00&quot; then &quot;24:00:00&quot; else [Snap-time Reference Price Low (UTC)]&#xA;endif" field="Snap-time Reference Price Low (UTC)" size="8" type="String" />
              </FormulaFields>
            </Configuration>
            <Annotation DisplayMode="0">
              <Name />
              <AnnotationText>Determining test status,
principal/most advantageous market, 
computing reference prices/MV and range</AnnotationText>
              <DefaultAnnotationText>Client Price (Local Currency) = [Client Market Value (Local Currency)] / [Asset ...</DefaultAnnotationText>
              <Left value="True" />
            </Annotation>
