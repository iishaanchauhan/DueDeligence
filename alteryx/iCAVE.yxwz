                <Field name="Market Value Low (Base Currency)" source="Formula: [Reference Price Low (Local Currency)] * [Asset Amount] *[FX rate local to base currency]" type="Double" />
                <Field name="Price Difference (Local Currency)" source="Formula: if [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA;[Client Price (Local Currency)] - [Reference Price (Local Currency)]&#xA;endif" type="Double" />
                <Field name="Price Difference Out of Range (Local Currency)" source="Formula: If [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA; IF [Client Price (Local Currency)] &gt;&#xA;  [Reference Price High (Local Currency)]&#xA;&#xA; THEN [Client Price (Local Currency)]-&#xA;  [Reference Price High (Local Currency)] &#xA;&#xA; elseif [Client Price (Local Currency)] &lt; &#xA;  [Reference Price Low (Local Currency)]&#xA;&#xA; then [Client Price (Local Currency)]-&#xA;  [Reference Price Low (Local Currency)]&#xA;    ELSE&#xA;    0&#xA;   ENDIF&#xA;endif" type="Double" />
                <Field name="Total Difference (Netted, Local Currency)" source="Formula: [Client Market Value (Local Currency)] - [Reference Market Value (Local Currency)]" type="Double" />
                <Field name="Difference Out of Range (Netted, Local Currency)" source="Formula: If [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA;[Price Deviation Out of Range (Local Currency)] * [Asset Amount]&#xA;endif&#xA;" type="Double" />
                <Field name="Difference Out of Range (Netted, Base Currency)" source="Formula: If [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA; [Price Deviation Out of Range (Local Currency)] &#xA; * [FX rate local to base currency] * [Asset Amount]&#xA;ENDIF&#xA;" type="Double" />
                <Field name="Difference Out of Range (Absolute, Base Currency)" source="Formula: ABS([Deviation Out of Range (Netted, Base Currency)])" type="Double" />
                <Field name="Total Difference (Netted, Base Currency)" source="Formula: [Price Deviation (Local Currency)] * [FX rate local to base currency] * [Asset Amount]" type="Double" />
                <Field name="Total Difference (Absolute, Base Currency)" source="Formula: ABS([Total Deviation (Netted, Base Currency)])" type="Double" />
