                <Field name="Reference Price (Local Currency)" source="Formula: if ([Reference Price High (Quote Currency)] - [Reference Price Low (Quote Currency)])/[Reference Price (Quote Currency)] &lt;= 0.05 &#xA;// cap the relative range at 5%&#xA;then&#xA;[Reference Price (Quote Currency)] * [FX rate to audited entity's local currency]&#xA;else Null()&#xA;endif &#xA;" type="Double" />
                <Field name="Reference Price (Base Currency)" source="Formula: if ([Reference Price High (Quote Currency)] - [Reference Price Low (Quote Currency)])/[Reference Price (Quote Currency)] &lt;= 0.05 &#xA;// cap the relative range at 5%&#xA;then&#xA;[Reference Price (Quote Currency)] * [FX rate to audited entity's base currency]&#xA;else Null()&#xA;endif" type="Double" />
