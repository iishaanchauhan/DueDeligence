                <Field name="Price Low from Exchange Rank 3" source="Formula: [_CurrentField_]*[FX rate to audited entity's local currency]" type="Double" />
                <Field name="Price Low from Exchange Rank 4" source="Formula: [_CurrentField_]*[FX rate to audited entity's local currency]" type="Double" />
                <Field name="Price Low from Exchange Rank 5" source="Formula: [_CurrentField_]*[FX rate to audited entity's local currency]" type="Double" />
                <Field name="Name of Exchange Rank 1" size="2048" source="CrossTab:Header:Rank:1:Concat:" type="V_String" />
                <Field name="Name of Exchange Rank 2" size="2048" source="CrossTab:Header:Rank:2:Concat:" type="V_String" />
                <Field name="Name of Exchange Rank 3" size="2048" source="CrossTab:Header:Rank:3:Concat:" type="V_String" />
                <Field name="Name of Exchange Rank 4" size="2048" source="CrossTab:Header:Rank:4:Concat:" type="V_String" />
                <Field name="Name of Exchange Rank 5" size="2048" source="CrossTab:Header:Rank:5:Concat:" type="V_String" />
                <Field name="Valuation Date Internal" source="Formula: if [Snap Time] = &quot;24:00:00&quot; then DateTimeAdd([Valuation Date],1,&quot;day&quot;)&#xA;else [Valuation Date]&#xA;endif" type="Date" />
                <Field name="Snap Time Internal" source="Formula: if [Snap Time] = &quot;24:00:00&quot; then DateTimeParse(&quot;00:00:00&quot;,&quot;%H:%M:%S&quot;)&#xA;else [Snap Time]&#xA;endif" type="Time" />
                <Field name="Audited Entity Price (Local Currency)" source="Formula: [Client Market Value (Local Currency)] / [Asset Amount]&#xA;" type="Double" />
                <Field name="Median Price (Quote Currency)" source="Formula: IF&#xA;Uppercase([Price type]) = &quot;MID&quot; &#xA;THEN&#xA;[Reference price (mid)] &#xA;else&#xA;[Reference price (bid)]&#xA;ENDIF" type="Double" />
                <Field name="Median Price (Local Currency)" source="Formula: if ([Reference Price High (Quote Currency)] - [Reference Price Low (Quote Currency)])/[Reference Price (Quote Currency)] &lt;= 0.05 &#xA;// cap the relative range at 5%&#xA;then&#xA;[Reference Price (Quote Currency)] * [FX rate to audited entity's local currency]&#xA;else Null()&#xA;endif &#xA;" type="Double" />
                <Field name="Median Price (Base Currency)" source="Formula: if ([Reference Price High (Quote Currency)] - [Reference Price Low (Quote Currency)])/[Reference Price (Quote Currency)] &lt;= 0.05 &#xA;// cap the relative range at 5%&#xA;then&#xA;[Reference Price (Quote Currency)] * [FX rate to audited entity's base currency]&#xA;else Null()&#xA;endif" type="Double" />
                <Field name="FX rate local to base currency" source="Formula: [FX rate to audited entity's base currency]/[FX rate to audited entity's local currency]" type="Double" />
                <Field name="Client Market Value Tested Calculated (Base Currency)" source="Formula: if [Test Status]=&quot;No&quot;&#xA;then Null()&#xA;else [Client Market Value (Local Currency)] * [FX rate local to base currency]&#xA;endif" type="Double" />
                <Field name="Client Market Value Tested (Base Currency)" source="Formula: if [Test Status] = &quot;Yes&quot;&#xA;then&#xA;[Client Market Value (Base Currency)]&#xA;else&#xA;Null()&#xA;endif" type="Double" />
                <Field name="Price High (Local Currency)" source="Formula: IF IsNull([Reference Price (Local Currency)]) &#xA; then Null()&#xA;elseif Uppercase([Price type]) = &quot;BID&quot; THEN &#xA; [Reference Price High (Quote Currency)]/[Reference price (mid)] &#xA;    * [Reference price (bid)] &#xA;    *[FX rate to audited entity's local currency]&#xA;ELSE &#xA; [Reference Price High (Quote Currency)] * [FX rate to audited entity's local currency] ENDIF " type="Double" />
                <Field name="Price Low (Local Currency)" source="Formula: IF IsNull([Reference Price (Local Currency)]) &#xA; then Null()&#xA;elseif Uppercase([Price type]) = &quot;BID&quot; &#xA; THEN &#xA; [Reference Price Low (Quote Currency)]/[Reference price (mid)]&#xA; *[Reference price (bid)] * [FX rate to audited entity's local currency]&#xA;ELSE [Reference Price Low (Quote Currency)] * [FX rate to audited entity's local currency]&#xA;ENDIF" type="Double" />
                <Field name="Market Value (Local Currency)" source="Formula: [Reference Price (Local Currency)] * [Asset Amount]" type="Double" />
                <Field name="Market Value High (Local Currency)" source="Formula: [Reference Price High (Local Currency)] * [Asset Amount]" type="Double" />
                <Field name="Market Value Low (Local Currency)" source="Formula: [Reference Price Low (Local Currency)] * [Asset Amount]" type="Double" />
                <Field name="Market Value (Base Currency)" source="Formula: [Reference Price (Base Currency)] * [Asset Amount]" type="Double" />
                <Field name="Market Value High (Base Currency)" source="Formula: [Reference Price High (Local Currency)] * [Asset Amount] * [FX rate local to base currency]" type="Double" />
                <Field name="Market Value Low (Base Currency)" source="Formula: [Reference Price Low (Local Currency)] * [Asset Amount] *[FX rate local to base currency]" type="Double" />
                <Field name="Price Difference (Local Currency)" source="Formula: if [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA;[Client Price (Local Currency)] - [Reference Price (Local Currency)]&#xA;endif" type="Double" />
                <Field name="Price Difference Out of Range (Local Currency)" source="Formula: If [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA; IF [Client Price (Local Currency)] &gt;&#xA;  [Reference Price High (Local Currency)]&#xA;&#xA; THEN [Client Price (Local Currency)]-&#xA;  [Reference Price High (Local Currency)] &#xA;&#xA; elseif [Client Price (Local Currency)] &lt; &#xA;  [Reference Price Low (Local Currency)]&#xA;&#xA; then [Client Price (Local Currency)]-&#xA;  [Reference Price Low (Local Currency)]&#xA;    ELSE&#xA;    0&#xA;   ENDIF&#xA;endif" type="Double" />
                <Field name="Total Difference (Netted, Local Currency)" source="Formula: [Client Market Value (Local Currency)] - [Reference Market Value (Local Currency)]" type="Double" />
                <Field name="Difference Out of Range (Netted, Local Currency)" source="Formula: If [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA;[Price Deviation Out of Range (Local Currency)] * [Asset Amount]&#xA;endif&#xA;" type="Double" />
                <Field name="Difference Out of Range (Netted, Base Currency)" source="Formula: If [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;else&#xA; [Price Deviation Out of Range (Local Currency)] &#xA; * [FX rate local to base currency] * [Asset Amount]&#xA;ENDIF&#xA;" type="Double" />
                <Field name="Difference Out of Range (Absolute, Base Currency)" source="Formula: ABS([Deviation Out of Range (Netted, Base Currency)])" type="Double" />
                <Field name="Total Difference (Netted, Base Currency)" source="Formula: [Price Deviation (Local Currency)] * [FX rate local to base currency] * [Asset Amount]" type="Double" />
                <Field name="Total Difference (Absolute, Base Currency)" source="Formula: ABS([Total Deviation (Netted, Base Currency)])" type="Double" />
                <Field name="Out of Range" size="1073741823" source="Formula: // Official name: Out of range&#xA;if [Test Status] = &quot;No&quot;&#xA;then Null()&#xA;elseif [Deviation Out of Range (Netted, Base Currency)] = 0&#xA;then &quot;No&quot; &#xA;else &quot;Yes&quot;&#xA;endif" type="V_WString" />
              </RecordInfo>
              <SortInfo>
                <Field field="RecordID" order="Ascending" />
              </SortInfo>
            </MetaInfo>
          </Properties>
